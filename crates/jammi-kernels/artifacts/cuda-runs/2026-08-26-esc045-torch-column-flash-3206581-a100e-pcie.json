  "flash_dispatch_counter_evidence": {
    "mechanism": "crates/jammi-encoders/src/modernbert.rs's ModernBertAttention::forward_training_attention (at git_sha above): admit_cascade(admission_mode(), \"attention_block_flash\", flash.reason(), flash.outcome(), true, cascade_counters_for(\"attention_block_flash\")) is evaluated FIRST, per layer; on CascadeOutcome::Fused it returns EARLY via forward_flash_dense_attention -- the admit(..., \"attention_block_fused\", ...) call (whose own counters are attention_block_fused_dispatches / attention_block_eager_dispatches, the ONLY attention counters crates/jammi-bench/src/grad_oracle.rs itself reads -- it never calls jammi_encoders::attention_block_flash_dispatch_snapshot(), which was added only to finetune_step.rs/report.rs's FinetuneStepTier) is never reached at all on a fully-flash-eligible run. So on this build, a grad-oracle fused-arm dump reading attention_block_fused_dispatches==0 AND attention_block_eager_dispatches==0 for every layer is exactly what flash firing on every layer looks like from grad-oracle's own JSON -- confirmed directly below, and corroborated by a finetune-step smoke test on the SAME binary/checkpoint/dtype/LoRA config, which DOES expose the flash cascade's own counters.",
    "grad_oracle_direct_evidence": {
      "source": "b4-s128-seed42__gaussian__jammi_bf16_fused.json raw dump (admit_key_dispatches), inspected before deletion",
      "attention_block_fused_dispatches": 0,
      "attention_block_eager_dispatches": 0,
      "rope_fused_dispatches": 0,
      "softmax_fused_dispatches": 0,
      "note": "rope_fused/softmax_fused also read 0 -- consistent with flash_attention_varlen_with_rope fusing RoPE INSIDE the flash op (forward_flash_dense_attention's own doc), so neither the block arm's admit nor the standalone RoPE/softmax fused ops are ever reached either."
    },
    "finetune_step_corroborating_smoke_test": {
      "invocation": "jammi-bench finetune-step --model-dir /root/checkpoints/ModernBERT-large --batch 4 --seq 128 --steps 3 --warmup 1 --lora-rank 16 --lora-alpha 32 --target-modules Wqkv,Wo,Wi --backbone-dtype bf16 --cuda 0 --seed 42 (same binary, same checkpoint, same LoRA config as the grad-oracle legs)",
      "attention_block_flash_fused_dispatches": 112,
