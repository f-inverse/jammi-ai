+def _run_git(args: list[str], cwd: str) -> tuple[bool, str]:
+    """Runs `git -C <cwd> <args>` with a 5s timeout. `(True, stdout)` on
+    success; `(False, reason)` naming the failing command on any failure
+    (non-zero exit, timeout, or git/the cwd being unusable) — the caller
+    always turns a `False` into a DENY, never a silent allow.
+
+    Runs in its OWN process group and, on timeout, kills the WHOLE group —
+    not merely the direct child. A `git` that spawns a grandchild holding the
+    stdout/stderr pipes open (e.g. a hung network helper — or, in the
+    fixture's PATH-shimmed reproduction, a `sh -c 'sleep 30 & exec sleep 7'`
+    that leaves the backgrounded `sleep 30` as an orphan after the shim's own
+    `exec` returns) is not killed by `proc.kill()` alone — Python's own
+    post-timeout pipe-drain then blocks on that orphan's own file
+    descriptors. On POSIX, `subprocess.run`'s post-timeout `wait()` already
+    returns once the direct child is reaped (measured: ~5s, not unbounded,
+    for a childless timeout); `os.killpg`'s real, measured benefit is REAPING
+    the orphaned grandchild — leaving it running would otherwise hold the
+    process table entry and, in the pipe-holding case, keep the read end
+    open indefinitely. Both matter; killpg covers both in one call."""
+    cmd = ["git", "-C", cwd] + list(args)
+    printable = "git " + " ".join(args)
+    try:
+        proc = subprocess.Popen(
+            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            start_new_session=True,  # its own process group, for the kill below
+        )
+    except OSError as exc:
+        return False, f"`{printable}` failed to run ({exc}) — {_ESCAPE_HATCH_NOTE}"
+    try:
+        out, _err = proc.communicate(timeout=_GIT_TIMEOUT_S)
+    except subprocess.TimeoutExpired:
+        try:
