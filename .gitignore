# Devcontainer
.devcontainer/.bash_history

# Rust
/target
*.db
*.db-wal
*.db-shm

# Generated by Cargo
debug
**/*.rs.bk
*.pdb

# Cargo mutants
**/mutants.out*/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
.venv/
*.so
# maturin develop drops a debug-symbols bundle next to the extension module
*.dSYM/

# Test artifacts
/tmp/jammi-test-*/

# HuggingFace cache (large, downloaded at runtime)
.cache/

# mdbook build output
docs/guide/book/

# TypeScript client (@jammi/client) — generated-at-build, never committed.
# The proto stays the single source; `src/gen` is emitted by `buf generate`.
clients/typescript/node_modules/
clients/typescript/src/gen/

# Python client (jammi-ai) — generated-at-build, never committed.
# The proto stays the single source; `_generated/` is emitted by `make generate`.
clients/python/jammi/_generated/
clients/python/.venv/
clients/python/dist/
clients/python/build/
clients/python/*.egg-info/

# Server wheels (jammi-server / jammi-server-cu12) — the compiled `jammi-server`
# binary is injected under `jammi_server/bin/` by CI at build time, never
# committed. The `.gitkeep` keeps the directory; the binary itself is ignored.
packaging/*/jammi_server/bin/jammi-server
packaging/*/dist/
packaging/*/build/

# In-repo cargo target + tmp dirs (CARGO_TARGET_DIR / TMPDIR for local gating)
.cargo-target/
.target/
.tmp/

# Claude — personal settings stay local; the committed swarm files are tracked.
# (settings.local.json and worktrees/ stay ignored by the .claude/* rule above.)
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/evals/
!.claude/settings.json
!.claude/AGENTS.md
# Swarm runtime state: the escape ledger (.jammi/escapes.jsonl) is tracked; the
# per-session facts ledger, domain mutex locks, and the lead-proactivity gate's
# own hook-written state (bindings + per-unit verdict rows; branch-keyed, local
# to one machine — cross-machine loss is accepted and documented) are
# ephemeral, never committed.
.jammi/ledger/
.jammi/locks/
.jammi/gate-state/
CLAUDE.md
docs/plans/*
# Maintainer roadmap / journey docs are tracked despite the docs/plans/ rule.
!docs/plans/52-maintainer-roadmap/
!docs/plans/53-agentic-swarm/
!docs/plans/54-python-ecosystem/
!docs/plans/55-precision-moat/
!docs/plans/61-perf-unification/
!docs/plans/62-embedding-surface/
!docs/plans/63-how-well/
docs/superpowers/
docs/IMPLEMENTATION.md
docs/specs/
# Artifacts pulled off a GPU pod by `ci/scripts/gpu-dev.sh pull`.
.gpu-pull/

# Lead-session scratch: working notes/drafts and throwaway git worktrees.
# Session-local by design, never committed — tracked files that cite a
# scratchpad/ path must label it session-local evidence.
/scratchpad/
/scratch-worktrees/

# The PyTorch/PEFT reference venv `ci/scripts/perf/finetune_ab.sh` provisions
# on the pod (crates/jammi-bench/reference/README.md's own `.venv-torch-ref`
# convention) and the A/B sweep's merged report + table it writes.
.venv-torch-ref/
.ab-report/
